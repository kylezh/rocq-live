#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""rocq-live: live Rocq proof sessions for any project, no per-project setup.

  rocq-live goto  FILE[:LINE] [--full]  proof state just before LINE (default:
                                      end of file). Starts a session if none
                                      runs; afterwards re-checks only from the
                                      first changed character: edit, goto,
                                      repeat. With a LINE, a finished Qed proof
                                      before it that was not edited is taken as
                                      Admitted (statement checked, tactics not);
                                      --full, or no LINE, checks every proof
  rocq-live run   FILE[:LINE] 'TAC.'  run sentences on the current state (or on
                                      the state before LINE), print the goals
                                      or the error (error: no change)
  rocq-live query FILE 'CMD.'         run, print, undo (Search, Check, Print, About)
  rocq-live try   FILE 'T1.' 'T2.' ..  run each tactic alone on the current state:
                                      which work, goals left; state unchanged
  rocq-live audit FILE [NAME..] [--allow AX,..]  Admitted/admit/axioms and
                                      Print Assumptions vs the allowed axioms
  rocq-live back  FILE [N]            undo the last N runs (default 1)
  rocq-live goals FILE                print the current goals
  rocq-live start FILE [LINE]         like goto, but always a fresh session
  rocq-live stop  FILE | --all        stop the session(s) at once
  rocq-live list                      running sessions: memory, idle time, limits
  rocq-live gc                        apply the limits now (also automatic)
  rocq-live info  FILE                project root, toolchain and load path found
  rocq-live mcp                       serve the same commands as MCP tools (stdio)

Each session is a background process holding one `coqtop -emacs` for one file,
so a step costs only that step: no prefix replays.

Project detection (from FILE's directory upwards, nearest marker wins):
  .rocq-live     optional config, `key value` lines (see below)
  dune-project   load path from `dune coq top` (also builds what FILE imports)
  _CoqProject    load path from its -Q/-R/-I/-arg lines (build it yourself)
Toolchain: the config's `switch`, else $ROCQ_LIVE_SWITCH, else the current opam
switch if it has coqtop, else coqtop on PATH.

.rocq-live keys (all optional; relative paths are from its directory):
  switch   rocq-9.0               opam switch (`path`: use coqtop on PATH)
  flags    -Q theories My         load path flags, verbatim
  loadpath scripts/loadpath.sh {file}   command printing the flags; may build
  build    make -j8 vos           command run before each start/goto
  axioms   classic functional_extensionality_dep   axioms `audit` accepts

Limits (machine-wide; environment, else ~/.config/rocq-live/config with the
same `key value` lines; read at each use, so changes apply to running sessions):
  max_mb       ROCQ_LIVE_MAX_MB       all sessions together (default: half the RAM)
  session_mb   ROCQ_LIVE_SESSION_MB   one session (default: max_mb)
  max_sessions ROCQ_LIVE_MAX_SESSIONS (default 16)
  grace        ROCQ_LIVE_GRACE        a session used this recently (seconds) is
                                      not stopped for max_sessions (default 600)
  idle         ROCQ_LIVE_IDLE         seconds before an idle session exits (1200;
                                      its recipe restores it on next use)
Over max_mb, or over max_sessions (sparing sessions used within `grace`), the
least recently used idle sessions are stopped (GC: when a session starts, after
each request, and every second while a step runs). A step that takes a session over session_mb, or the total over
max_mb with nothing idle left to stop, is interrupted, and that session's
coqtop is restarted to give the memory back. A busy session is never stopped.
Environment: ROCQ_LIVE_FLAGS (load path override), ROCQ_LIVE_SWITCH,
ROCQ_LIVE_TIMEOUT (seconds per step; default 600 for goto/start, 120 others),
ROCQ_LIVE_TRY_TIMEOUT (seconds per tactic in `try`; default 30),
ROCQ_LIVE_FAST=0 (goto checks every proof, as --full),
ROCQ_LIVE_DAEMON=0 (no background process: each call starts coqtop, rebuilds
the state from the recipe and exits; slower per call, nothing left running).

Recipes: each session saves its last goto line and the runs on top of it in
~/.cache/rocq-live/recipes (kept 7 days). A session stopped by gc, the idle
timeout or a reboot is restored from it on its next use (fast replay), and
says so; `stop` forgets it.

A running session watches the .vo/.vos files of the project modules it has
loaded; when one is rebuilt, the session restarts coqtop and replays the file
to the last goto line and the runs on top, and says so. `goto` also rebuilds
FILE's imports first (dune, or the `build`/`loadpath` command), so: edit an
imported file, then goto, and the new version is used.
"""
import hashlib
import json
import os
import re
import select
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time

VERSION = "0.1.0"
SELF = os.path.abspath(__file__)
SESSION_DIR = "/tmp/rocq-live-%d" % os.getuid()   # short: AF_UNIX paths <= 104
TIMEOUT_GOTO = 600          # replaying a long prefix can be slow
TIMEOUT_STEP = 120          # a run/query longer than this is a hang to fix
USER_CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                           "rocq-live", "config")
LOG_KEEP = 86400            # the log of a dead session is kept this long (debugging)
RECIPE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                          "rocq-live", "recipes")
RECIPE_KEEP = 7 * 86400     # a session's recipe (line + runs) is kept this long
WATCH_EVERY = 1.0           # seconds between memory checks while a step runs
GRACE_MEMORY = 5            # after an interrupt for memory, wait this long, then kill coqtop
GRACE_TIMEOUT = 20          # same, after an interrupt for time
ECHO_ENV = "ROCQ_LIVE_ECHO_ARGV"
ECHO_TAG = "ROCQ_LIVE_ARGV "


class Fail(Exception):
    """A user-facing error: the message is the whole report."""


# ---------------------------------------------------------------- limits

def phys_mb():
    try:
        return os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / (1 << 20)
    except (ValueError, OSError, AttributeError):
        return 16384.0


def limits():
    """Machine-wide session limits, read at each use so a change applies to
    running sessions: environment, else ~/.config/rocq-live/config (`key
    value` lines), else defaults."""
    cfg = {}
    try:
        with open(USER_CONFIG, encoding="utf-8") as f:
            for raw in f:
                key, _, val = raw.split("#")[0].strip().partition(" ")
                if key:
                    cfg[key] = val.strip()
    except OSError:
        pass

    def get(env, key, default):
        val = os.environ.get(env) or cfg.get(key)
        try:
            return float(val) if val else default
        except ValueError:
            return default
    total = get("ROCQ_LIVE_MAX_MB", "max_mb", phys_mb() / 2)
    return {"max_mb": total,
            "session_mb": min(get("ROCQ_LIVE_SESSION_MB", "session_mb", total), total),
            "max_sessions": max(1, int(get("ROCQ_LIVE_MAX_SESSIONS", "max_sessions", 16))),
            "grace": get("ROCQ_LIVE_GRACE", "grace", 600),
            "idle": get("ROCQ_LIVE_IDLE", "idle", 1200)}


def fmt_mb(mb):
    return "%.1f GB" % (mb / 1024) if mb >= 1024 else "%d MB" % mb


def group_mb():
    """Resident memory (MB) of every process group, from one `ps` call. A
    session is a process group (its daemon and coqtop)."""
    r = subprocess.run(["ps", "-A", "-o", "pgid=,rss="], capture_output=True, text=True)
    out = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0].isdigit() and parts[1].isdigit():
            g = int(parts[0])
            out[g] = out.get(g, 0) + int(parts[1]) / 1024
    return out


# ---------------------------------------------------------------- sentences

def next_sentence_end(text, start):
    """End offset (just past the terminator) of the sentence starting at
    `start`, or None if there is no complete sentence there. A sentence ends
    at a `.` followed by white space or the end of text, outside comments
    (nested) and strings, and not part of `..`; a `{` or `}` that starts a
    sentence is a sentence of its own (focusing braces)."""
    i, n, depth, started = start, len(text), 0, False
    while i < n:
        c = text[i]
        if text.startswith("(*", i):
            depth += 1; i += 2; continue
        if depth:
            if text.startswith("*)", i):
                depth -= 1; i += 2
            else:
                i += 1
            continue
        if c == '"':                      # string; "" is an escaped quote
            i += 1
            while i < n and not (text[i] == '"' and not text.startswith('""', i)):
                i += 2 if text.startswith('""', i) else 1
            i += 1; started = True; continue
        if not started and c in "{}":
            return i + 1
        if c == "." and (i + 1 == n or text[i + 1].isspace()) and not (i > 0 and text[i - 1] == "."):
            return i + 1
        if not c.isspace():
            started = True
        i += 1
    return None


def strip_comments(text):
    out, depth, i = [], 0, 0
    while i < len(text):
        if text.startswith("(*", i):
            depth += 1; i += 2
        elif depth and text.startswith("*)", i):
            depth -= 1; i += 2
        else:
            if not depth:
                out.append(text[i])
            i += 1
    return "".join(out)


def only_blank(text):
    """True if `text` holds no sentence (only white space and comments)."""
    return re.sub(r"\s", "", strip_comments(text)) == ""


def complete(text):
    """True if `text` is a non-empty sequence of complete sentences."""
    off, n = 0, 0
    while True:
        end = next_sentence_end(text, off)
        if end is None:
            return n > 0 and only_blank(text[off:])
        off, n = end, n + 1


def line_offset(text, line):
    """Offset of the start of 1-based `line` (len(text) past the end)."""
    off = 0
    for _ in range(line - 1):
        nl = text.find("\n", off)
        if nl < 0:
            return len(text)
        off = nl + 1
    return off


# ------------------------------------------------------------ project setup

def find_up(start, names):
    """Nearest directory at or above `start` holding one of `names`; returns
    (dir, set of the names present there) or (None, set())."""
    d = start
    while True:
        here = {n for n in names if os.path.exists(os.path.join(d, n))}
        if here:
            return d, here
        parent = os.path.dirname(d)
        if parent == d:
            return None, set()
        d = parent


def read_config(path):
    cfg = {}
    with open(path, encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            key, _, val = line.partition(" ")
            if key not in ("switch", "flags", "loadpath", "build", "axioms"):
                raise Fail("rocq-live: %s: unknown key %r (switch, flags, loadpath, build, axioms)"
                           % (path, key))
            cfg[key] = val.strip()
    return cfg


def parse_coqproject(path):
    """The load-path flags of a _CoqProject, with absolute directories."""
    base = os.path.dirname(path)
    with open(path, encoding="utf-8") as f:
        toks = shlex.split(f.read(), comments=True)
    flags, i = [], 0
    while i < len(toks):
        t = toks[i]
        if t in ("-Q", "-R") and i + 2 < len(toks):
            flags += [t, os.path.join(base, toks[i + 1]), toks[i + 2]]; i += 3
        elif t == "-I" and i + 1 < len(toks):
            flags += [t, os.path.join(base, toks[i + 1])]; i += 2
        elif t == "-arg" and i + 1 < len(toks):
            flags += shlex.split(toks[i + 1]); i += 2
        else:
            i += 1                        # file names and makefile options
    return flags


_env_cache = {}


def toolchain_env(switch, root):
    """(environment, description) for running coqtop. `switch` is an opam
    switch name, "path", or None (pick: current opam switch with coqtop, else
    PATH)."""
    key = (switch, root)
    if key in _env_cache:
        return _env_cache[key]
    env, desc = dict(os.environ), "coqtop on PATH"
    env.pop(ECHO_ENV, None)
    if switch != "path" and shutil.which("opam"):
        sw = switch
        if not sw:
            r = subprocess.run(["opam", "switch", "show"], cwd=root, capture_output=True, text=True)
            sw = r.stdout.strip() if r.returncode == 0 else None
        if sw:
            r = subprocess.run(["opam", "exec", "--switch=" + sw, "--", "env", "-0"],
                               cwd=root, capture_output=True)
            if r.returncode == 0:
                oenv = dict(kv.split("=", 1) for kv in r.stdout.decode().split("\0") if "=" in kv)
                if shutil.which("coqtop", path=oenv.get("PATH")) or switch:
                    env, desc = oenv, "opam switch " + sw
            elif switch:
                raise Fail("rocq-live: cannot select opam switch %s:\n%s" % (sw, r.stderr.decode()))
    elif switch and switch != "path":
        raise Fail("rocq-live: config asks for opam switch %s but opam is not installed" % switch)
    env.pop(ECHO_ENV, None)
    _env_cache[key] = (env, desc)
    return env, desc


def toplevel_cmd(env):
    if shutil.which("coqtop", path=env.get("PATH")):
        return ["coqtop"]
    if shutil.which("rocq", path=env.get("PATH")):
        return ["rocq", "repl"]
    raise Fail("rocq-live: no coqtop (or rocq) found; set `switch` in .rocq-live or ROCQ_LIVE_SWITCH")


def run_tool(cmd, cwd, env, what, shell=False):
    """Run a setup command; its stdout on success, Fail with its output else."""
    r = subprocess.run(cmd, cwd=cwd, env=env, shell=shell, capture_output=True, text=True)
    if r.returncode != 0:
        raise Fail("rocq-live: %s failed (exit %d); FILE's imports do not build:\n%s%s"
                   % (what, r.returncode, r.stdout[-6000:], r.stderr[-6000:]))
    return r.stdout


def dune_flags(path, env, proj_dir):
    """`dune rocq top` / `dune coq top` builds FILE's imports, then runs the
    toplevel with the right flags. The toplevel is this script, which only
    prints its argv as JSON (paths may contain spaces, so `--toplevel=echo`
    is not enough). Projects on `(using rocq ...)` need `dune rocq top`, those
    on `(using coq ...)` need `dune coq top` (removed in newer dune): try the
    one the project names first, then the other."""
    e = dict(env); e[ECHO_ENV] = "1"
    try:
        with open(os.path.join(proj_dir, "dune-project"), encoding="utf-8") as f:
            rocq_first = re.search(r"\(using\s+rocq\b", f.read()) is not None
    except OSError:
        rocq_first = False
    errors = []
    for sub in (["rocq", "coq"] if rocq_first else ["coq", "rocq"]):
        r = subprocess.run(["dune", sub, "top", "--display=quiet", "--toplevel=" + SELF,
                            os.path.basename(path)], cwd=os.path.dirname(path), env=e,
                           capture_output=True, text=True)
        for line in r.stdout.splitlines():
            if line.startswith(ECHO_TAG):
                return json.loads(line[len(ECHO_TAG):])
        errors.append("$ dune %s top ... (exit %d)\n%s%s"
                      % (sub, r.returncode, r.stdout[-4000:], r.stderr[-4000:]))
        if "unknown command" not in r.stderr:
            break                     # a real error (a build failure): report it
    raise Fail("rocq-live: dune could not build FILE's imports or give its load path "
               "(is %s in a coq.theory/rocq.theory?):\n%s" % (path, "\n".join(errors)))


def resolve(path, build=True):
    """Project of `path`: {root, kind, flags, env, desc, cmd}. With `build`,
    first run whatever brings FILE's imports up to date."""
    start_dir = os.path.dirname(path)
    cfg_dir, _ = find_up(start_dir, [".rocq-live"])
    proj_dir, here = find_up(start_dir, ["dune-project", "dune-workspace", "_CoqProject"])
    root = cfg_dir or proj_dir or find_up(start_dir, [".git"])[0] or start_dir
    cfg = read_config(os.path.join(cfg_dir, ".rocq-live")) if cfg_dir else {}
    switch = cfg.get("switch") or os.environ.get("ROCQ_LIVE_SWITCH") or None
    env, desc = toolchain_env(switch, root)
    qfile = shlex.quote(path)
    if build and cfg.get("build"):
        run_tool(cfg["build"].replace("{file}", qfile), root, env, "build command", shell=True)
    if os.environ.get("ROCQ_LIVE_FLAGS"):
        kind, flags = "ROCQ_LIVE_FLAGS", shlex.split(os.environ["ROCQ_LIVE_FLAGS"])
    elif cfg.get("flags"):
        kind, flags = ".rocq-live flags", shlex.split(cfg["flags"])
    elif cfg.get("loadpath"):
        cmd = cfg["loadpath"].replace("{file}", qfile)
        kind, flags = ".rocq-live loadpath", shlex.split(run_tool(cmd, root, env, "loadpath command", shell=True))
    elif "dune-project" in here or "dune-workspace" in here:
        kind, flags = "dune", dune_flags(path, env, proj_dir)
    elif "_CoqProject" in here:
        kind, flags = "_CoqProject", parse_coqproject(os.path.join(proj_dir, "_CoqProject"))
    else:
        kind, flags = "none (no .rocq-live, dune-project or _CoqProject found)", []
    # relative directories in flags are relative to the root
    out, i = [], 0
    while i < len(flags):
        if flags[i] in ("-Q", "-R") and i + 2 < len(flags):
            out += [flags[i], os.path.join(root, flags[i + 1]), flags[i + 2]]; i += 3
        elif flags[i] == "-I" and i + 1 < len(flags):
            out += [flags[i], os.path.join(root, flags[i + 1])]; i += 2
        else:
            out.append(flags[i]); i += 1
    return {"root": root, "kind": kind, "flags": out, "env": env, "desc": desc,
            "cmd": toplevel_cmd(env), "axioms": cfg.get("axioms", "").split()}


# ------------------------------------------------------------ coqtop driver

PROMPT = re.compile(r"<prompt>[^\n]*? < (\d+) \|[^\n]*?</prompt>")
ERROR = re.compile(r"^Error:", re.M)


class StepTimeout(Exception):
    pass


class Coqtop:
    """One coqtop -emacs process. `send(text)` runs complete sentences and
    returns (output, error?); `state` is the state id after them."""

    def __init__(self, cmd, flags, cwd, env):
        self.p = subprocess.Popen(cmd + ["-q", "-emacs"] + flags, cwd=cwd, env=env,
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.STDOUT)
        self.marks, self.timeout, self.buf = 0, TIMEOUT_GOTO, b""
        self.watch, self.why = None, None   # watch(): reason to interrupt, or None
        out, _ = self._read_until(lambda s: PROMPT.search(s), TIMEOUT_GOTO)
        self.state = int(PROMPT.findall(out)[-1])

    def _read_until(self, done, timeout):
        """Read until done(output); after `timeout` seconds interrupt the
        running command (SIGINT) and keep reading. (output, interrupted?)"""
        deadline, interrupted = time.time() + timeout, False
        next_watch = time.time() + WATCH_EVERY
        while True:
            s = self.buf.decode("utf-8", "replace")
            if done(s):
                self.buf = b""
                return s, interrupted
            if self.watch and not interrupted and time.time() >= next_watch:
                next_watch = time.time() + WATCH_EVERY
                why = self.watch()
                if why:                   # over a memory limit: stop the step now
                    self.why = why
                    os.kill(self.p.pid, signal.SIGINT)
                    interrupted, deadline = True, time.time() + GRACE_MEMORY
                    continue
            left = deadline - time.time()
            if left <= 0:
                if interrupted:
                    # SIGINT did not stop it (some Rocq versions do not poll
                    # for it in the VM): kill coqtop; the session restarts it
                    self.p.kill()
                    self.p.wait()
                    raise StepTimeout("coqtop did not respond to an interrupt; killed it")
                os.kill(self.p.pid, signal.SIGINT)
                interrupted, deadline = True, time.time() + GRACE_TIMEOUT
                continue
            r, _, _ = select.select([self.p.stdout], [], [], min(left, 1.0))
            if r:
                chunk = os.read(self.p.stdout.fileno(), 1 << 16)
                if not chunk:
                    raise StepTimeout("coqtop exited:\n" + s[-4000:])
                self.buf += chunk

    def send(self, text):
        """Run `text`, then a marker command whose message (a unique name)
        followed by a prompt means all is done."""
        self.marks += 1
        mark = "rocq_live_mark_%d" % self.marks
        self.p.stdin.write((text + "\nFail Check %s.\n" % mark).encode())
        self.p.stdin.flush()

        def done(s):
            k = s.find(mark + " was not found")
            return k >= 0 and PROMPT.search(s, k)
        out, interrupted = self._read_until(done, self.timeout)
        k = out.find(mark + " was not found")
        body = out[:out.rfind("The command has indeed failed", 0, k)]
        self.state = int(PROMPT.findall(out[k:])[-1])
        error = bool(ERROR.search(body)) or interrupted
        if interrupted and self.why:
            body += "\nrocq-live: step interrupted: %s" % self.why
        elif interrupted:
            body += "\nrocq-live: step interrupted after %d s (ROCQ_LIVE_TIMEOUT)" % self.timeout
        return clean(body), error

    def back_to(self, state):
        self.send("BackTo %d." % state)

    def close(self):
        try:
            self.p.stdin.close()
            self.p.wait(10)
        except Exception:
            self.p.kill()


def clean(out):
    """coqtop -emacs output without prompts and markup."""
    out = PROMPT.sub("", out)
    out = re.sub(r"</?infomsg>|</?warning>", "", out)
    return re.sub(r"\n{3,}", "\n\n", out).strip("\n")


# ------------------------------------------------- watching loaded modules

LOADED = re.compile(r"^\s+([A-Za-z0-9_'.]+)\s*$", re.M)
_hashes = {}


def bindings(flags, root):
    """(logical prefix, directory) of each -Q/-R inside the project: only
    project modules are watched (installed libraries do not change)."""
    out, i = [], 0
    while i < len(flags):
        if flags[i] in ("-Q", "-R") and i + 2 < len(flags):
            d = os.path.realpath(flags[i + 1])
            if d == root or d.startswith(root + os.sep):
                out.append((flags[i + 2], d))
            i += 3
        else:
            i += 1
    return out


def products(libraries_output, binds):
    """Build products coqtop may have loaded for the project modules listed
    by `Print Libraries`: the .vo and the .vos of each binding that fits."""
    paths = []
    for lib in LOADED.findall(libraries_output):
        for prefix, d in binds:
            if lib.startswith(prefix + "."):
                rel = lib[len(prefix) + 1:].replace(".", os.sep)
                paths += [os.path.join(d, rel + ".vo"), os.path.join(d, rel + ".vos")]
    return paths


def fingerprint(path):
    """Content hash (None if missing), recomputed only when mtime/size change:
    a product restored with the same content is not a change."""
    try:
        st = os.stat(path)
    except OSError:
        return None
    key = (st.st_mtime_ns, st.st_size)
    hit = _hashes.get(path)
    if hit is None or hit[0] != key:
        with open(path, "rb") as f:
            hit = (key, hashlib.sha1(f.read()).hexdigest())
        _hashes[path] = hit
    return hit[1]


# ------------------------------------------------- try / audit helpers

def error_text(out, limit=240):
    """The message of the first error in `out`, on one line."""
    k = out.find("Error:")
    if k < 0:
        lines = out.strip().splitlines()
        return lines[-1] if lines else "error"
    msg = " ".join(out[k + len("Error:"):].split())
    msg = msg.split(" rocq-live:")[0]
    return "Error: " + (msg[:limit] + " ..." if len(msg) > limit else msg)


def goal_count(out):
    """Goals left in a tactic's output: 0 when it closed them."""
    if re.search(r"No more (sub)?goals|This subproof is complete|All the remaining goals are on the shelf", out):
        return 0
    m = re.search(r"^(\d+) (?:focused )?goals?\b", out, re.M)
    return int(m.group(1)) if m else 1


def goals_word(n):
    return "no goals left" if n == 0 else "%d goal%s left" % (n, "" if n == 1 else "s")


def first_lines(text, n):
    lines = text.strip("\n").splitlines()
    return "\n".join(lines[:n] + (["... (%d more lines)" % (len(lines) - n)] if len(lines) > n else []))


def indent(text):
    return "\n".join("    " + l for l in text.splitlines())


def short_list(names, n=5):
    return ", ".join(names[:n]) + (" and %d more" % (len(names) - n) if len(names) > n else "")


def blank_comments(text):
    """`text` with comments and strings replaced by spaces (newlines kept), so
    offsets and line numbers still match the file."""
    out, i, depth, n = list(text), 0, 0, len(text)
    while i < n:
        if text.startswith("(*", i):
            depth += 1; out[i] = out[i + 1] = " "; i += 2; continue
        if depth:
            if text.startswith("*)", i):
                depth -= 1; out[i] = out[i + 1] = " "; i += 2; continue
            if text[i] != "\n":
                out[i] = " "
            i += 1; continue
        if text[i] == '"':
            j = i + 1
            while j < n and not (text[j] == '"' and not text.startswith('""', j)):
                j += 2 if text.startswith('""', j) else 1
            for k in range(i, min(j + 1, n)):
                if out[k] != "\n":
                    out[k] = " "
            i = j + 1; continue
        i += 1
    return "".join(out)


ADMITS = re.compile(r"\b(Admitted\s*\.|admit\b|give_up\b|Admit\s+Obligations\b)")
AXIOM_DECL = re.compile(r"(?m)^\s*(?:#\[[^\]]*\]\s*)?(?:(?:Local|Global|Polymorphic|Monomorphic)\s+)*"
                        r"(Axioms?|Conjectures?|Parameters?)\s+([A-Za-z_][\w']*)")
DECL = re.compile(r"^(?:#\[[^\]]*\]\s*)?(?:(?:Local|Global|Program|Polymorphic|Monomorphic|Equations)\s+)*"
                  r"(Theorem|Lemma|Corollary|Proposition|Fact|Remark|Example|Property|Definition|"
                  r"Fixpoint|CoFixpoint|Instance)\s+([A-Za-z_][\w']*)")


def scan_admits(text):
    """(line, what) of each admit and axiom declaration in `text` (comments
    already blanked)."""
    found = []
    for m in ADMITS.finditer(text):
        found.append((text.count("\n", 0, m.start()) + 1, m.group(1).split()[0].rstrip(".")))
    for m in AXIOM_DECL.finditer(text):
        found.append((text.count("\n", 0, m.start(1)) + 1, "%s %s" % (m.group(1), m.group(2))))
    return sorted(found)


def declarations(text):
    """Qualified names of the file's declarations (modules tracked; nothing
    inside a Module Type, whose contents are not constants)."""
    names, stack, off = [], [], 0
    while True:
        end = next_sentence_end(text, off)
        if end is None:
            break
        sent = " ".join(text[off:end].split())
        off = end
        m = re.match(r"^(?:Module|Declare Module)\s+Type\s+([\w']+)", sent)
        if m:
            if ":=" not in sent:
                stack.append(("T", m.group(1)))
            continue
        m = re.match(r"^Module\s+(?:(?:Import|Export)\s+)?([\w']+)", sent)
        if m:
            if ":=" not in sent:
                stack.append(("M", m.group(1)))
            continue
        m = re.match(r"^Section\s+([\w']+)", sent)
        if m:
            stack.append(("S", m.group(1)))
            continue
        m = re.match(r"^End\s+([\w']+)\s*\.$", sent)
        if m:
            for k in range(len(stack) - 1, -1, -1):
                if stack[k][1] == m.group(1):
                    del stack[k:]
                    break
            continue
        m = DECL.match(sent)
        if m and not any(k == "T" for k, _ in stack):
            names.append(".".join([n for k, n in stack if k == "M"] + [m.group(2)]))
    return names


def axioms_of(out):
    """Axiom names in `Print Assumptions` output ([] when closed)."""
    axs, section = [], None
    for line in out.splitlines():
        if re.match(r"^[A-Z][A-Za-z ]+:$", line):
            section = line[:-1]
        elif section == "Axioms" and re.match(r"^\S+ :", line):
            axs.append(line.split(" :")[0])
    return axs


def axiom_allowed(ax, allowed):
    """`Print Assumptions` prints the shortest unambiguous name: match either
    way round on a qualified suffix."""
    return any(ax == a or ax.endswith("." + a) or a.endswith("." + ax) for a in allowed)


# ------------------------------------------------- fast replay

# A sentence that opens a proof: a theorem-like statement without `:=`.
STMT = re.compile(r"^(?:#\[[^\]]*\]\s*)?(?:(?:Local|Global|Polymorphic|Monomorphic|Program)\s+)*"
                  r"(Theorem|Lemma|Corollary|Proposition|Fact|Remark|Example|Property|Goal|"
                  r"Definition|Fixpoint|CoFixpoint|Instance)\b")


def norm_sentence(blank, a, b):
    return " ".join(blank[a:b].split())


def fast_enabled():
    return os.environ.get("ROCQ_LIVE_FAST", "1") != "0"


def section_depths(blank):
    """{sentence start offset: number of open Sections there}."""
    depths, stack, off = {}, [], 0
    while True:
        end = next_sentence_end(blank, off)
        if end is None:
            return depths
        t = norm_sentence(blank, off, end)
        depths[off] = sum(1 for k in stack if k == "S")
        m = re.match(r"^(Section|Module(?:\s+Type)?)\s+(?:(?:Import|Export)\s+)?([\w']+)", t)
        if m and ":=" not in t:
            stack.append("S" if m.group(1) == "Section" else "M")
        elif re.match(r"^End\s+[\w']+\s*\.$", t) and stack:
            stack.pop()
        off = end


def skippable(new, blank, off, end, target, edit, depths):
    """If the sentence new[off:end] opens a finished opaque proof that ends
    before `target`, does not overlap the edited region `edit` and can be
    replaced by Admitted without changing what follows, return (offsets of a
    `Proof using` sentence or None, end of the proof's Qed/Admitted)."""
    t = norm_sentence(blank, off, end)
    m = STMT.match(t)
    if not m or ":=" in t or re.search(r"\bProgram\b", t.split(m.group(1))[0]):
        return None
    using, p, first = None, end, True
    while True:
        e2 = next_sentence_end(new, p)
        if e2 is None:
            return None
        u = norm_sentence(blank, p, e2)
        if not u:
            p = e2
            continue
        if first and u.startswith("Proof"):
            if re.match(r"^Proof\s+using\b", u):
                using = (p, e2)
            elif not re.match(r"^Proof\s*(with\b.*)?\.$", u):
                return None              # `Proof term.` ends the proof by itself
        elif re.match(r"^(Qed|Admitted)\s*\.$", u):
            stop = e2
            break
        elif re.match(r"^(Defined|Abort|Save)\b", u) or (STMT.match(u) and ":=" not in u):
            return None                  # transparent, aborted, or a nested proof
        first = False
        p = e2
    if stop > target or (off < edit[1] and stop > edit[0]):
        return None
    if depths.get(off, 0) and not (using or "using" in t.split(m.group(1))[0]):
        return None    # in a Section, Admitted would generalize differently without `Proof using`
    return using, stop


# ------------------------------------------------- recipes

def recipe_path(path):
    return os.path.join(RECIPE_DIR, hashlib.sha1(path.encode()).hexdigest()[:12] + ".json")


def save_recipe(path, line, runs):
    try:
        os.makedirs(RECIPE_DIR, exist_ok=True)
        tmp = recipe_path(path) + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"file": path, "line": line, "runs": runs, "saved": time.time()}, f)
        os.replace(tmp, recipe_path(path))
    except OSError:
        pass


def load_recipe(path):
    try:
        with open(recipe_path(path)) as f:
            r = json.load(f)
        if r.get("file") == path and time.time() - r.get("saved", 0) < RECIPE_KEEP:
            return r
    except (OSError, ValueError):
        pass
    return None


def drop_recipe(path):
    try:
        os.unlink(recipe_path(path))
    except OSError:
        pass


# --------------------------------------------------------------- session

class Session:
    """The file's checked prefix: `done` lists (end offset, coqtop state) of
    each sentence checked, `text` the file as last read, `runs` stacks
    (state before, text) of each run, `line` the last goto target, `loaded`
    the fingerprint of each watched product when it was loaded."""

    def __init__(self, path, proj):
        self.path, self.name = path, os.path.relpath(path, proj["root"])
        self.line, self.loaded = 0, {}
        self.watch = None          # memory watchdog, given to every coqtop started
        self.configure(proj)

    def configure(self, proj):
        self.proj = proj
        self.binds = bindings(proj["flags"], os.path.realpath(proj["root"]))
        self.start_coqtop()

    def start_coqtop(self):
        p = self.proj
        self.coq = Coqtop(p["cmd"], p["flags"], p["root"], p["env"])
        self.coq.watch = self.watch
        self.done, self.text, self.runs = [(0, self.coq.state)], "", []
        self.skipped = []          # (body start, proof end) of proofs taken as Admitted

    def note_loaded(self):
        out, _ = self.coq.send("Print Libraries.")
        for p in products(out, self.binds):
            if p not in self.loaded:
                fp = fingerprint(p)
                if fp is not None:
                    self.loaded[p] = fp

    def changed(self):
        root = self.proj["root"]
        return sorted(os.path.relpath(p, root) for p, fp in self.loaded.items()
                      if fingerprint(p) != fp)

    def restart(self, note, cmd):
        """Restart coqtop; unless the request is itself a goto, replay the
        file to the last goto line and the runs on top."""
        runs = [text for _, text in self.runs]
        self.coq.close()
        self.loaded = {}
        self.start_coqtop()
        if cmd == "goto":
            return note
        out, failed = self.goto(self.line)
        if failed:
            return note + "; replaying %s stopped at an error:\n%s" % (self.name, out)
        for text in runs:
            out, err = self.run(text)
            if err:
                return note + "; replayed to line %s, but this run now fails: %s\n%s" % (
                    self.line or "EOF", text, out)
        return note + "; replayed to line %s%s" % (
            self.line or "EOF", " and %d run(s)" % len(runs) if runs else "")

    def before(self, cmd, proj):
        """Before a request: pick up a new load path or rebuilt imports."""
        if proj and any(proj[k] != self.proj[k] for k in ("flags", "cmd", "desc")):
            self.coq.close()
            self.loaded = {}
            self.configure(proj)
            return "rocq-live: the load path changed; restarted coqtop"
        changed = self.changed()
        if not changed:
            return ""
        shown = ", ".join(changed[:4]) + (" ..." if len(changed) > 4 else "")
        return self.restart("rocq-live: %s changed since it was loaded; restarted coqtop" % shown, cmd)

    def line_of(self, off):
        return self.text.count("\n", 0, off) + 1

    def goto(self, line, full=False):
        """State just before `line` (0: end of file). Re-checks from the first
        changed character. Unless `full`, a finished Qed proof before the
        target that was not edited is taken as Admitted (its statement is
        checked, its tactics are not), as `coqc -vos` does: everything else in
        the file (imports, scopes, notations, options) is replayed as usual."""
        with open(self.path, encoding="utf-8") as f:
            new = f.read()
        target = line_offset(new, line) if line else len(new)
        self.line = line
        full = full or not line          # the whole file: check every proof
        old = self.text
        d, m = 0, min(len(old), len(new))       # first changed character
        while d < m and old[d] == new[d]:
            d += 1
        if d == m and len(old) == len(new):
            d = len(new) + 1
        # the edited region of the new text: [d, len(new) - common suffix)
        if not old or d > len(new):
            edit = (len(new) + 1, len(new) + 1)
        else:
            k = 0
            while k < m - d and old[len(old) - 1 - k] == new[len(new) - 1 - k]:
                k += 1
            edit = (d, max(len(new) - k, d + 1))
        if full:          # re-check proofs taken as Admitted before the target
            for body, stop in self.skipped:
                if body < target:
                    d = min(d, body)
                    break
        keep = [e for e in self.done if e[0] == 0 or (e[0] < d and e[0] <= target)]
        if keep != self.done or self.runs:
            self.coq.back_to(keep[-1][1])
        self.done, self.runs, self.text = keep, [], new
        self.skipped = [(b, e) for b, e in self.skipped if e <= keep[-1][0]]
        fast = not full and fast_enabled()
        blank = blank_comments(new) if fast else None
        depths = section_depths(blank) if fast else {}
        msgs, failed, off, skipped_now = [], False, self.done[-1][0], 0
        while True:
            end = next_sentence_end(new, off)
            if end is None or end > target:
                break
            if only_blank(new[off:end]):
                off = end; continue
            blk = skippable(new, blank, off, end, target, edit, depths) if fast else None
            if blk:
                using, stop = blk
                parts = [(new[off:end], end)]
                if using:
                    parts.append((new[using[0]:using[1]], using[1]))
                parts.append(("Admitted.", stop))
                bad = None
                for text, at_end in parts:
                    out, err = self.coq.send(text)
                    if err:
                        bad = out
                        break
                    self.done.append((at_end, self.coq.state))
                if bad is None:
                    self.skipped.append((end, stop))
                    skipped_now += 1
                    off = stop
                    continue
                # the statement itself fails: report it like any error
                while self.done[-1][0] > off:
                    self.done.pop()
                out, err = bad, True
            else:
                out, err = self.coq.send(new[off:end])
            if err:
                at = self.line_of(off + len(new[off:end]) - len(new[off:end].lstrip()))
                self.coq.back_to(self.done[-1][1])
                failed = True
                msgs.append("rocq-live: error in the sentence at %s line %d; stopped before it\n%s"
                            % (self.name, at, out))
                break
            self.done.append((end, self.coq.state))
            off = end
        self.note_loaded()
        stop = self.line_of(self.done[-1][0]) if self.done[-1][0] else 0
        msgs.append(self.goals())
        msgs.append("rocq-live: checked up to %s line %d (asked for line %s)"
                    % (self.name, stop, line or "EOF"))
        n = len(self.skipped)
        if n:
            msgs.append("rocq-live: %d finished proof(s) before it taken as Admitted%s (statements "
                        "checked, tactics not; goto --full checks them)"
                        % (n, " (%d just now)" % skipped_now if skipped_now != n else ""))
        return "\n".join(msgs), failed

    def handle(self, cmd, arg):
        """One request: (output, error?). goto/run/back also save the
        session's recipe (line + runs) so it can be restored later."""
        if cmd == "goto":
            a = arg if isinstance(arg, dict) else {"line": arg or 0}
            res = self.goto(a.get("line") or 0, bool(a.get("full")))
        elif cmd == "run":
            res = self.run(arg)
        elif cmd == "query":
            res = self.query(arg)
        elif cmd == "back":
            res = self.back(arg)
        elif cmd == "goals":
            res = self.goals(), False
        elif cmd == "try":
            res = self.try_(arg["tactics"], arg["each_timeout"])
        elif cmd == "audit":
            res = self.audit(arg.get("names") or [], arg.get("allow") or self.proj.get("axioms") or [])
        else:
            return "rocq-live: unknown command " + cmd, True
        if cmd in ("goto", "run", "back", "audit"):
            save_recipe(self.path, self.line, [t for _, t in self.runs])
        return res

    def run(self, text):
        if not complete(text):
            return "rocq-live: give complete sentences ending with '.'", True
        before = self.coq.state
        out, err = self.coq.send(text)
        if err:
            self.coq.back_to(before)
            return out + "\nrocq-live: error; state unchanged", True
        self.runs.append((before, text))
        self.note_loaded()
        return out or self.goals(), False

    def query(self, text):
        before = self.coq.state
        out, err = self.coq.send(text)
        self.coq.back_to(before)
        return out, err

    def back(self, n):
        if n < 1 or n > len(self.runs):
            return "rocq-live: %d run(s) to undo, asked %d" % (len(self.runs), n), True
        state = self.runs[-n][0]
        del self.runs[-n:]
        self.coq.back_to(state)
        return self.goals(), False

    def goals(self):
        out, err = self.coq.send("Show.")
        return "(no open proof)" if err or not out else out

    def try_(self, tactics, each_timeout):
        """Run each tactic alone on the current state, then undo it: which
        ones work, and what they leave. The state is unchanged."""
        before, timeout, rows = self.coq.state, self.coq.timeout, []
        for i, tac in enumerate(tactics, 1):
            text = tac if complete(tac) else tac.rstrip() + "."
            if not complete(text):
                rows.append((i, tac, None, "not a complete sentence"))
                continue
            self.coq.timeout = min(each_timeout, timeout)
            try:
                out, err = self.coq.send(text)
            finally:
                self.coq.timeout = timeout
            if not err and not out:
                out = self.goals()
            self.coq.back_to(before)
            rows.append((i, tac, None if err else goal_count(out), out))
        ok = [r for r in rows if r[2] is not None]
        ok.sort(key=lambda r: r[2])
        head = "rocq-live: %d of %d tactics work; state unchanged" % (len(ok), len(rows))
        if ok:
            head += "; best: [%d] %s (%s)" % (ok[0][0], ok[0][1], goals_word(ok[0][2]))
        lines = [head]
        for i, tac, n, out in rows:
            if n is None:
                lines.append("[%d] %s -> FAILS: %s" % (i, tac, error_text(out)))
            else:
                lines.append("[%d] %s -> works (%s)" % (i, tac, goals_word(n)))
                if n and len(tactics) > 1:
                    lines.append(indent(first_lines(out, 12)))
                elif n:
                    lines.append(indent(out))
        return "\n".join(lines), not ok

    def audit(self, names, allowed):
        """Admitted/admit/axioms in the file, and `Print Assumptions` of its
        declarations (or of `names`) against the allowed axioms. Checks the
        whole file first; afterwards the session is back where it was."""
        line, runs = self.line, [text for _, text in self.runs]
        out, failed = self.goto(0, full=True)
        if failed:
            return ("rocq-live audit %s: FAIL (the file does not check)\n%s" % (self.name, out)), True
        text = blank_comments(self.text)
        static = scan_admits(text)
        decls = names or declarations(text)
        uses, unchecked = {}, []
        for name in decls:
            res, err = self.query("Print Assumptions %s." % name)
            if err:
                unchecked.append((name, error_text(res)))
            else:
                uses[name] = axioms_of(res)
        bad, ok_used = {}, {}
        for name, axs in uses.items():
            for ax in axs:
                (ok_used if axiom_allowed(ax, allowed) else bad).setdefault(ax, []).append(name)
        # an axiom declared here is fine if allowed; an admit fails the audit
        # unless only some NAMES were asked for (then their Print Assumptions
        # decides: it lists every admitted lemma they depend on)
        failing = [(ln, w) for ln, w in static
                   if not (w.split()[0].rstrip("s") in ("Axiom", "Parameter", "Conjecture")
                           and axiom_allowed(w.split()[1], allowed))]
        if names:
            failing = []
        verdict = "FAIL" if (failing or bad or unchecked) else "PASS"
        rep_ = ["rocq-live audit %s: %s" % (self.name, verdict)]
        for ln, what in static:
            tag = "" if (ln, what) in failing else (
                "  (elsewhere in the file)" if names else "  (allowed)")
            rep_.append("  line %d: %s%s" % (ln, what, tag))
        for ax, who in sorted(bad.items()):
            rep_.append("  axiom not allowed: %s  (used by %s)" % (ax, short_list(who)))
        for ax, who in sorted(ok_used.items()):
            rep_.append("  allowed axiom: %s  (used by %s)" % (ax, short_list(who)))
        for name, e in unchecked:
            rep_.append("  could not check %s: %s" % (name, e))
        closed = sum(1 for axs in uses.values() if not axs)
        rep_.append("  %d declaration(s) checked with Print Assumptions, %d closed; allowed axioms: %s"
                    % (len(uses), closed, " ".join(allowed) or "(none: set `axioms` in .rocq-live)"))
        # back to where the session was
        back_out, back_failed = self.goto(line)
        for t in runs:
            o, e = self.run(t)
            if e:
                rep_.append("rocq-live: note: after the audit, this run no longer applies: %s" % t)
                break
        return "\n".join(rep_), verdict == "FAIL"


# ---------------------------------------------------------- daemon

def sock_path(path):
    return os.path.join(SESSION_DIR, hashlib.sha1(path.encode()).hexdigest()[:12] + ".sock")


def write_line(conn, obj):
    conn.sendall((json.dumps(obj) + "\n").encode())


_code = None


def code_id():
    """Hash of this script: a session started by another version is restarted."""
    global _code
    if _code is None:
        with open(SELF, "rb") as f:
            _code = hashlib.sha1(f.read()).hexdigest()[:12]
    return _code


def touch(path):
    with open(path, "a"):
        os.utime(path)


def serve(path, sock, projfile):
    """Daemon body: one request at a time, each a JSON line, answered with a
    JSON line {out, err}. While a request runs, `.busy` exists (GC never stops
    a busy session); `.used` is touched at each request (least recently used
    sessions are stopped first)."""
    with open(projfile) as f:
        proj = json.load(f)
    os.unlink(projfile)
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(sock)
    srv.listen(16)
    for ext, val in ((".file", path), (".pid", str(os.getpid())), (".code", code_id())):
        with open(sock + ext, "w") as f:
            f.write(val)
    touch(sock + ".used")
    pgid = os.getpgid(0)
    notes = []
    floor = [0.0]     # memory just after the last restart: limits below it cannot be met
    base = [0.0]      # memory when the current request began

    def session_limit(lim):
        return max(lim["session_mb"], floor[0] * 1.25)

    def watch():
        """While a step runs: over the per-session limit, interrupt it; over
        the total, stop idle sessions (GC) and interrupt only if that is not
        enough."""
        lim, mem = limits(), group_mb()
        own = mem.get(pgid, 0)
        if own > session_limit(lim):
            return ("this session uses %s, over the per-session limit %s (session_mb)"
                    % (fmt_mb(own), fmt_mb(session_limit(lim))))
        total = sum(m for g, m in mem.items() if g in session_groups())
        if total > lim["max_mb"]:
            notes.extend(gc(keep=sock))
            mem = group_mb()
            total = sum(m for g, m in mem.items() if g in session_groups())
            # interrupt only a step that is itself growing: stopping a quiet
            # one would not bring the total down
            if total > lim["max_mb"] and own > base[0] + 64:
                return ("the sessions use %s together, over the limit %s (max_mb), and no idle "
                        "session is left to stop" % (fmt_mb(total), fmt_mb(lim["max_mb"])))
        return None

    session = None
    try:
        try:
            session = Session(path, proj)     # requests wait in the backlog
            session.watch = session.coq.watch = watch
        except (StepTimeout, OSError, IndexError) as e:
            boot_error = "rocq-live: coqtop did not start: %s" % e
        else:
            boot_error = None
        while True:
            r, _, _ = select.select([srv], [], [], limits()["idle"])
            if not r:
                break                          # idle too long
            conn, _ = srv.accept()
            with conn:
                line = conn.makefile().readline()
                if not line:
                    continue                   # a liveness probe
                if boot_error:
                    write_line(conn, {"out": boot_error, "err": True})
                    break
                req = json.loads(line)
                cmd, arg = req["cmd"], req.get("arg")
                if cmd == "stop":
                    write_line(conn, {"out": "rocq-live: session stopped", "err": False})
                    break
                touch(sock + ".busy"); touch(sock + ".used")
                del notes[:]
                base[0] = group_mb().get(pgid, 0)
                try:
                    session.coq.timeout, session.coq.why = TIMEOUT_GOTO, None
                    note = session.before(cmd, req.get("proj"))
                    session.coq.timeout = req.get("timeout", TIMEOUT_GOTO)
                    out, err = session.handle(cmd, arg)
                    # memory: a step that was stopped for memory, or a coqtop
                    # still over the per-session limit, keeps its heap: restart
                    # coqtop to give it back (the file is replayed)
                    lim = limits()
                    own = group_mb().get(pgid, 0)
                    if session.coq.why or own > session_limit(lim):
                        session.coq.why = None
                        notes.append(session.restart(
                            "rocq-live: this session used %s (per-session limit %s); restarted "
                            "coqtop to free it" % (fmt_mb(own), fmt_mb(session_limit(lim))), "replay"))
                        floor[0] = group_mb().get(pgid, 0)
                        if floor[0] > lim["session_mb"]:
                            notes.append("rocq-live: even freshly started, this file needs %s, more "
                                         "than session_mb %s; using %s as its limit (raise session_mb)"
                                         % (fmt_mb(floor[0]), fmt_mb(lim["session_mb"]),
                                            fmt_mb(session_limit(lim))))
                    notes.extend(gc(keep=sock))
                except StepTimeout as e:
                    if session.coq.p.poll() is None:      # coqtop hangs: give up
                        write_line(conn, {"out": "rocq-live: session lost: %s" % e, "err": True})
                        break
                    # coqtop died during the step (a crash in Rocq): start it
                    # again where the session was; the step is not applied
                    try:
                        session.coq.timeout = TIMEOUT_GOTO
                        what = ("did not stop when interrupted (%s); killed it" % (session.coq.why or "too slow")
                                if "did not respond" in str(e) else
                                "died during this step (exit %s)" % session.coq.p.returncode)
                        session.coq.why = None
                        note2 = session.restart("rocq-live: coqtop %s; restarted it" % what, "replay")
                    except StepTimeout as e2:
                        write_line(conn, {"out": "rocq-live: session lost: %s\n%s" % (e, e2), "err": True})
                        break
                    out, err = ("%s\nrocq-live: the step was not applied" % note2 if "did not respond" in str(e)
                                else "%s\n%s\nrocq-live: the step was not applied" % (str(e)[:4000], note2)), True
                    note = ""
                finally:
                    try:
                        os.unlink(sock + ".busy")
                    except OSError:
                        pass
                    touch(sock + ".used")
                if note:
                    out = note + "\n" + out
                if notes:
                    out = out + "\n" + "\n".join(notes)
                write_line(conn, {"out": out, "err": err})
    finally:
        if session:
            session.coq.close()
        srv.close()
        for ext in SUFFIXES:
            try:
                os.unlink(sock + ext)
            except OSError:
                pass


# ---------------------------------------------------------- client API
# Each returns (text, error?). Used by the CLI and by the MCP server.

def norm(file):
    path = os.path.realpath(os.path.abspath(os.path.expanduser(file)))
    if not path.endswith(".v") or not os.path.isfile(path):
        raise Fail("rocq-live: no such .v file: " + file)
    return path


def alive(sock):
    try:
        c = socket.socket(socket.AF_UNIX)
        c.connect(sock)
        c.close()
        return True
    except OSError:
        return False


SUFFIXES = ("", ".file", ".pid", ".busy", ".used", ".proj", ".code")


def kill_session(sock):
    """Kill the daemon's process group (daemon and coqtop) at once: a stop
    request would wait behind a step that is still running."""
    try:
        os.killpg(int(open(sock + ".pid").read()), signal.SIGKILL)
    except (OSError, ValueError):
        pass
    for ext in SUFFIXES:
        try:
            os.unlink(sock + ext)
        except OSError:
            pass


def mtime(path, default=0.0):
    try:
        return os.path.getmtime(path)
    except OSError:
        return default


def sweep():
    """Live sessions, least recently used first, as dicts {sock, file, pid,
    busy, used, mb}; on the way, remove what dead sessions left behind (a
    file younger than a minute may belong to a session still starting)."""
    if not os.path.isdir(SESSION_DIR):
        return []
    now, live = time.time(), []
    socks = {os.path.join(SESSION_DIR, n[:n.index(".sock") + 5])
             for n in os.listdir(SESSION_DIR) if ".sock" in n}
    mem = None
    for sock in sorted(socks):
        if alive(sock):
            if mem is None:
                mem = group_mb()
            try:
                pid = int(open(sock + ".pid").read())
                name = open(sock + ".file").read()
            except (OSError, ValueError):
                continue
            live.append({"sock": sock, "file": name, "pid": pid, "busy": os.path.exists(sock + ".busy"),
                         "used": mtime(sock + ".used", mtime(sock + ".file")), "mb": mem.get(pid, 0)})
            continue
        for ext in SUFFIXES:
            if now - mtime(sock + ext, now) > 60:
                try:
                    os.unlink(sock + ext)
                except OSError:
                    pass
        if now - mtime(sock + ".log", now) > LOG_KEEP:
            try:
                os.unlink(sock + ".log")
            except OSError:
                pass
    if os.path.isdir(RECIPE_DIR):
        for n in os.listdir(RECIPE_DIR):
            if now - mtime(os.path.join(RECIPE_DIR, n), now) > RECIPE_KEEP:
                try:
                    os.unlink(os.path.join(RECIPE_DIR, n))
                except OSError:
                    pass
    live.sort(key=lambda x: x["used"])
    return live


def session_groups():
    """Process groups of the live sessions (their daemons' pids)."""
    out = set()
    if os.path.isdir(SESSION_DIR):
        for n in os.listdir(SESSION_DIR):
            if n.endswith(".sock.pid"):
                try:
                    out.add(int(open(os.path.join(SESSION_DIR, n)).read()))
                except (OSError, ValueError):
                    pass
    return out


def gc(keep=None, adding=0):
    """Enforce the limits: stop least recently used idle sessions while they
    use more than max_mb together, or while there are more than max_sessions
    (counting `adding` sessions about to start). For the count only, a session
    used in the last `grace` seconds is spared: an agent between two tool
    calls looks idle but will be back, and stopping it costs a full re-check,
    while an extra idle coqtop costs only memory (which max_mb bounds). Never
    stops `keep` or a busy session. Returns a note per stopped session."""
    lim, live, notes, now = limits(), sweep(), [], time.time()
    count, total = len(live) + adding, sum(x["mb"] for x in live)
    for x in live:                       # least recently used first
        if x["sock"] == keep or x["busy"]:
            continue
        if total > lim["max_mb"]:
            why = "sessions used %s together, limit %s (max_mb)" % (fmt_mb(total), fmt_mb(lim["max_mb"]))
        elif count > lim["max_sessions"]:
            if now - x["used"] < lim["grace"]:
                continue                 # used recently: its agent is likely coming back
            why = "more than %d sessions (max_sessions)" % lim["max_sessions"]
        else:
            break
        kill_session(x["sock"])
        count, total = count - 1, total - x["mb"]
        notes.append("rocq-live: gc stopped the least recently used session %s (%s): %s"
                     % (x["file"], fmt_mb(x["mb"]), why))
    return notes


def upgraded(sock):
    """True if the session runs another version of this script."""
    try:
        return open(sock + ".code").read() != code_id()
    except OSError:
        return True


def request(sock, cmd, arg=None, proj=None):
    default = TIMEOUT_GOTO if cmd == "goto" else TIMEOUT_STEP
    timeout = float(os.environ.get("ROCQ_LIVE_TIMEOUT", default))
    c = socket.socket(socket.AF_UNIX)
    c.connect(sock)
    msg = {"cmd": cmd, "arg": arg, "timeout": timeout}
    if proj:
        msg["proj"] = proj
    c.sendall((json.dumps(msg) + "\n").encode())
    line = c.makefile().readline()
    c.close()
    if not line:
        return "rocq-live: the session ended; its log: %s.log" % sock, True
    resp = json.loads(line)
    return resp["out"], resp["err"]


def describe(path, proj):
    return "rocq-live: %s: %s, load path from %s (root %s)" % (
        os.path.basename(path), proj["desc"], proj["kind"], proj["root"])


def daemon_enabled():
    """ROCQ_LIVE_DAEMON=0: no background process; each call rebuilds the
    state from the file's recipe (fast replay) and exits."""
    return os.environ.get("ROCQ_LIVE_DAEMON", "1") != "0"


def start(file, line=0, full=False):
    path = norm(file)
    if not daemon_enabled():
        return local("goto", path, {"line": line, "full": full})
    proj = resolve(path)
    sock = sock_path(path)
    kill_session(sock)
    os.makedirs(SESSION_DIR, exist_ok=True)
    notes = gc(adding=1)
    projfile = sock + ".proj"
    with open(projfile, "w") as f:
        json.dump(proj, f)
    log = open(sock + ".log", "w")
    subprocess.Popen([sys.executable, "-I", SELF, "_serve", path, sock, projfile],
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True, cwd=proj["root"])
    for _ in range(200):
        if alive(sock):
            break
        time.sleep(0.05)
    else:
        return "rocq-live: session did not start; see %s.log" % sock, True
    out, err = request(sock, "goto", {"line": line, "full": full})
    return "\n".join(notes + [describe(path, proj), out]), err


def goto(file, line=0, full=False):
    path = norm(file)
    if not daemon_enabled():
        return local("goto", path, {"line": line, "full": full})
    sock = sock_path(path)
    if not alive(sock) or upgraded(sock):
        return start(file, line, full)
    proj = resolve(path)              # rebuild imports; maybe a new load path
    return request(sock, "goto", {"line": line, "full": full}, proj)


_notes = []          # notes for the next reply (a restored session)


def restore(file, path, sock, why):
    """Start a session again from its recipe: the last goto line (fast
    replay) and the runs made on top of it."""
    rec = load_recipe(path)
    if rec is None:
        raise Fail("rocq-live: no session for %s; start one with: rocq-live goto %s LINE"
                   % (file, file))
    t0 = time.time()
    out, err = start(file, rec["line"])
    if not alive(sock):
        raise Fail(out)
    lost = None
    for i, text in enumerate(rec["runs"]):
        o, e = request(sock, "run", text)
        if e:
            lost = (len(rec["runs"]) - i, text)
            break
    msg = ("rocq-live: %s; restored the session from its recipe in %.1f s: line %s and %d run(s)"
           % (why, time.time() - t0, rec["line"] or "EOF", len(rec["runs"]) - (lost[0] if lost else 0)))
    if lost:
        msg += "; the run `%s` no longer applies, so it and %d later one(s) were dropped" % (lost[1], lost[0] - 1)
    if err:
        msg += "\n" + out
    _notes.append(msg)


def _live(file):
    """The socket of FILE's session; restores a stopped or outdated one from
    its recipe."""
    path = norm(file)
    sock = sock_path(path)
    if not alive(sock):
        restore(file, path, sock, "the session had been stopped (gc, idle timeout or reboot)")
    elif upgraded(sock):
        restore(file, path, sock, "rocq-live was updated")
    return sock


def at_line(file, line):
    """With an explicit LINE, run/query/try first go to the state before it."""
    if line is None:
        return None
    out, err = goto(file, line)
    if err:
        raise Fail(out)
    return None


def run(file, text, line=None):
    if not daemon_enabled():
        return local("run", norm(file), text, line)
    at_line(file, line)
    return request(_live(file), "run", text)


def query(file, text, line=None):
    if not daemon_enabled():
        return local("query", norm(file), text, line)
    at_line(file, line)
    return request(_live(file), "query", text)


def back(file, n=1):
    if not daemon_enabled():
        return local("back", norm(file), int(n))
    return request(_live(file), "back", int(n))


def goals(file):
    if not daemon_enabled():
        return local("goals", norm(file))
    return request(_live(file), "goals")


def try_(file, tactics, line=None):
    if not tactics:
        raise Fail("rocq-live: give at least one tactic to try")
    each = float(os.environ.get("ROCQ_LIVE_TRY_TIMEOUT", "30"))
    arg = {"tactics": list(tactics), "each_timeout": each}
    if not daemon_enabled():
        return local("try", norm(file), arg, line)
    at_line(file, line)
    return request(_live(file), "try", arg)


def audit(file, names=None, allow=None):
    path = norm(file)
    arg = {"names": names or [], "allow": allow or []}
    if not daemon_enabled():
        return local("audit", path, arg)
    sock = sock_path(path)
    if not alive(sock) or upgraded(sock):
        out, err = start(file, 0)
        if not alive(sock):
            return out, True
    return request(sock, "audit", arg, resolve(path))


def local(cmd, path, arg=None, line=None):
    """No-daemon mode: a coqtop for this call only. The state comes from the
    recipe (the last goto line, fast replay, and the runs on top), or from
    LINE when given; goto/run/back save the recipe again."""
    proj = resolve(path)
    s = Session(path, proj)
    try:
        default = TIMEOUT_GOTO if cmd in ("goto", "audit") else TIMEOUT_STEP
        timeout = float(os.environ.get("ROCQ_LIVE_TIMEOUT", default))
        if cmd in ("goto", "audit"):
            s.coq.timeout = timeout
            return s.handle(cmd, arg)
        rec = load_recipe(path) if line is None else None
        s.coq.timeout = TIMEOUT_GOTO
        out, failed = s.goto(line if line is not None else (rec["line"] if rec else 0))
        if failed:
            return out, True
        notes = []
        for text in (rec["runs"] if rec else []):
            o, e = s.run(text)
            if e:
                notes.append("rocq-live: the saved run `%s` no longer applies; dropped it and later ones" % text)
                break
        s.coq.timeout = timeout
        res, err = s.handle(cmd, arg)       # run/back save the recipe again
        return "\n".join(notes + [res]), err
    finally:
        s.coq.close()


def stop(file):
    if file in ("--all", "all"):
        live = sweep()
        for x in live:
            kill_session(x["sock"])
            drop_recipe(x["file"])
        return "rocq-live: stopped %d session(s)" % len(live), False
    # no existence check: the file of a session may have been deleted
    path = os.path.realpath(os.path.abspath(os.path.expanduser(file)))
    kill_session(sock_path(path))
    drop_recipe(path)                     # an explicit stop: forget the state too
    return "rocq-live: session stopped", False


def sessions():
    """Live sessions with their memory and idle time, and the limits."""
    live, lim, now = sweep(), limits(), time.time()
    rows = []
    for x in reversed(live):              # most recently used first
        idle = now - x["used"]
        rows.append("%-8s %-8s %s%s" % (fmt_mb(x["mb"]),
                    "busy" if x["busy"] else "%dm idle" % (idle // 60) if idle >= 60 else "%ds idle" % idle,
                    x["file"], ""))
    total = sum(x["mb"] for x in live)
    rows.append("%d session(s), %s; limits: %d sessions (sparing those used in the last %dm), "
                "%s total, %s per session, %dm idle"
                % (len(live), fmt_mb(total), lim["max_sessions"], lim["grace"] // 60,
                   fmt_mb(lim["max_mb"]), fmt_mb(lim["session_mb"]), lim["idle"] // 60))
    return "\n".join(rows), False


def collect():
    notes = gc()
    return "\n".join(notes) or "rocq-live: gc: nothing to stop (within the limits)", False


def info(file):
    path = norm(file)
    proj = resolve(path, build=False)
    v = subprocess.run(proj["cmd"] + ["--version"], env=proj["env"], capture_output=True, text=True)
    flags = " ".join(shlex.quote(f) for f in proj["flags"])
    return ("root:      %s\nload path: %s\ntoolchain: %s (%s: %s)\nflags:     %s\nsession:   %s"
            % (proj["root"], proj["kind"], proj["desc"], " ".join(proj["cmd"]),
               (v.stdout.strip().splitlines() or ["?"])[0], flags or "(none)",
               "running" if alive(sock_path(path)) else "none")), False


HINTS = [
    (r"Cannot\s+find\s+a\s+physical\s+path\s+bound\s+to\s+logical\s+path\s+(\S+?)(?:\s+with\s+prefix\s+(\S+?))?\.?\s*$",
     lambda m: "no load-path binding covers %s. `rocq-live info FILE` shows the flags in use; add a "
     "-Q/-R for it (_CoqProject, the dune theory's `theories`, or `flags` in .rocq-live)"
     % ((m.group(2) + "." if m.group(2) else "") + m.group(1))),
    (r"Unable\s+to\s+locate\s+library\s+(\S+?)\.?\s*$",
     lambda m: "%s is not on the load path or not built yet. `rocq-live info FILE` shows the flags; "
     "build the library (or set `build` in .rocq-live)" % m.group(1)),
    (r"bad\s+version\s+number|compiled\s+with\s+another\s+version|incompatible\s+version",
     lambda m: "a .vo was built by a different Rocq than the coqtop in use. `rocq-live info FILE` "
     "shows the toolchain; use the one that built it (`switch` in .rocq-live, ROCQ_LIVE_SWITCH) or rebuild"),
    (r"Compiled\s+library\s+(\S+)\s+\(in\s+file[^)]*\)\s+makes\s+inconsistent\s+assumptions\s+over\s+library\s+(\S+)",
     lambda m: ("a .vo was built by a different Rocq/stdlib than the coqtop in use; check the toolchain "
                "(`rocq-live info FILE`) or rebuild"
                if re.match(r"(Corelib|Coq|Stdlib)\.", m.group(2)) else
                "%s is stale: it was compiled against an older %s. Rebuild %s (and what depends on it)"
                % (m.group(1), m.group(2), m.group(1)))),
    (r"step interrupted after \d+ s",
     lambda m: "the step ran too long (a diverging or very slow tactic). Try a cheaper tactic, or "
     "raise ROCQ_LIVE_TIMEOUT if it is really needed"),
    (r"over the per-session limit|over the limit \S+ \S+ \(max_mb\)",
     lambda m: "the step used too much memory; tactics that split goals repeatedly (destruct in a "
     "repeat, case analysis) can build huge goal trees: close branches as they appear"),
    (r"This command requires an open proof|No focused proof",
     lambda m: "no proof is open at this point: `goto` a line inside a proof first"),
]


def explain(out):
    """Plain-language hints for errors whose fix is not in the message."""
    hints = []
    for pat, msg in HINTS:
        m = re.search(pat, out, re.M)
        if m:
            h = "rocq-live hint: " + msg(m)
            if h not in hints:
                hints.append(h)
    return hints


def safe(fn, *args):
    try:
        out, err = fn(*args)
    except Fail as e:
        out, err = str(e), True
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        out, err = "rocq-live: %s: %s" % (type(e).__name__, e), True
    if _notes:
        out = "\n".join(_notes + [out])
        del _notes[:]
    if err:
        out = "\n".join([out] + explain(out))
    return out, err


