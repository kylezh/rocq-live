def tool_list():
    out = []
    for name, desc, props, req in TOOLS:
        # hints for clients' approval rules: no tool edits source files (a
        # goto may build the project's imports, as a build would); only
        # rocq_compile and rocq_impact exist to write files (.vo)
        out.append({"name": name, "description": desc,
                    "annotations": {"readOnlyHint": name not in ("rocq_compile", "rocq_impact"),
                                    "destructiveHint": False,
                                    "idempotentHint": name in ("rocq_goals", "rocq_sessions", "rocq_info", "rocq_try",
                                                               "rocq_stats"),
                                    "openWorldHint": False},
                    "inputSchema": {
            "type": "object", "required": req,
            "properties": {k: dict({"type": t, "description": d},
                                   **({"items": {"type": "string"}} if t == "array" else {}))
                           for k, (t, d) in props.items()}}})
    return out


def call_tool(name, a):
    f = a.get("file", "")
    if name == "rocq_goto":
        return safe(start if a.get("fresh") else goto, f, int(a.get("line") or 0), bool(a.get("full")))
    at = int(a["line"]) if a.get("line") else None
    if name == "rocq_run":
        return safe(run, f, a.get("text", ""), at)
    if name == "rocq_query":
        return safe(query, f, a.get("text", ""), at)
    if name == "rocq_try":
        tacs = a.get("tactics") or []
        return safe(try_, f, [tacs] if isinstance(tacs, str) else tacs, at)
    if name == "rocq_audit":
        return safe(audit, f, a.get("names") or [], a.get("allow") or [])
    if name == "rocq_check":
        return safe(check, f, bool(a.get("allow_stale")), False, bool(a.get("all_errors")))
    if name == "rocq_compile":
        return safe(compile_, f, bool(a.get("deps_only")))
    if name == "rocq_impact":
        return safe(impact, f)
    if name == "rocq_back":
        return safe(back, f, int(a.get("n") or 1))
    if name == "rocq_goals":
        return safe(goals, f)
    if name == "rocq_stop":
        return safe(stop, "--all" if a.get("all") else f)
    if name == "rocq_sessions":
        return safe(sessions)
    if name == "rocq_stats":
        return safe(stats, a.get("since") or "all", a.get("file") or None)
    if name == "rocq_info":
        return safe(info, f)
    return "unknown tool " + name, True


def mcp():
    """MCP over stdio: newline-delimited JSON-RPC 2.0. Calls run in threads
    (a session serialises its own requests), so one slow goto does not block
    work on another file."""
    global VIA
    VIA = "mcp"
    lock = threading.Lock()

    def send(obj):
        with lock:
            sys.stdout.write(json.dumps(obj) + "\n")
            sys.stdout.flush()

    def handle(msg):
        mid, method, params = msg.get("id"), msg.get("method"), msg.get("params") or {}
        if mid is None:
            return                                # a notification
        if method == "initialize":
            result = {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                      "capabilities": {"tools": {}},
                      "serverInfo": {"name": "rocq-live", "version": VERSION},
                      "instructions": "Live Rocq proof sessions. Use rocq_goto to see the "
                      "goal at a line (edit the file, then rocq_goto again: only the change "
                      "is re-checked), rocq_run/rocq_back to try tactics, rocq_query for "
                      "Search/Check/Print. To know whether a whole file compiles, use "
                      "rocq_check (coqc's verdict, re-checking only what changed) instead of "
                      "running coqc; rocq_compile writes the .vo when other files need it."}
        elif method == "tools/list":
            result = {"tools": tool_list()}
        elif method == "tools/call":
            text, err = call_tool(params.get("name"), params.get("arguments") or {})
            result = {"content": [{"type": "text", "text": text}], "isError": bool(err)}
        elif method == "ping":
            result = {}
        else:
            send({"jsonrpc": "2.0", "id": mid,
                  "error": {"code": -32601, "message": "method not found: %s" % method}})
            return
        send({"jsonrpc": "2.0", "id": mid, "result": result})

    last = {}

    def ordered(msg, prev, done):
        for ev in prev:
            ev.wait()
        try:
            handle(msg)
        finally:
            done.set()

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}})
            continue
        # calls on one file run in arrival order (each waits for the previous
        # one on that file); calls on other files run in parallel
        f = ((msg.get("params") or {}).get("arguments") or {}).get("file")
        key = os.path.realpath(os.path.expanduser(f)) if isinstance(f, str) and f else None
        # a call without a file (sessions, stop all) waits for every earlier call
        done = threading.Event()
        prev = [last[key]] if key in last else []
        if key is None:
            prev = list(last.values())
        if key and "*" in last:
            prev.append(last["*"])
        last[key or "*"] = done
        threading.Thread(target=ordered, args=(msg, prev, done), daemon=True).start()
    for ev in list(last.values()):        # stdin closed: answer what is in flight
        ev.wait()
    return 0


# ---------------------------------------------------------- CLI

def split_file_line(args):
    """FILE:LINE or FILE [LINE]."""
    f, rest = args[0], args[1:]
    m = re.match(r"^(.*\.v):(\d+)$", f)
    if m:
        return m.group(1), int(m.group(2)), rest
    if rest and rest[0].isdigit():
        return f, int(rest[0]), rest[1:]
    return f, 0, rest


def main(argv):
    if os.environ.get(ECHO_ENV):                  # we are dune's --toplevel
        print(ECHO_TAG + json.dumps(argv))
        return 0
    if argv[:1] == ["_serve"] and len(argv) == 4:
        serve(argv[1], argv[2], argv[3]); return 0
    usage = __doc__.split("\n\n")[1]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "mcp":
        return mcp()
    if cmd in ("list", "sessions"):
        out, err = safe(sessions)
    elif cmd == "gc":
        out, err = safe(collect)
    elif cmd == "stats":
        since, rest = "all", list(args)
        if "--since" in rest:
            i = rest.index("--since")
            if i + 1 >= len(rest):
                print(usage, file=sys.stderr); return 2
            since = rest[i + 1]
            del rest[i:i + 2]
        if len(rest) > 1:
            print(usage, file=sys.stderr); return 2
        out, err = safe(stats, since, rest[0] if rest else None)
    elif cmd == "try" and len(args) >= 2:
        f, line, _ = split_file_line(args[:1])
        out, err = safe(try_, f, args[1:], line or None)
    elif cmd == "audit" and args:
        names, allow, rest = [], [], args[1:]
        while rest:
            if rest[0] == "--allow" and len(rest) > 1:
                allow += rest[1].replace(",", " ").split(); rest = rest[2:]
            else:
                names.append(rest[0]); rest = rest[1:]
        out, err = safe(audit, args[0], names, allow)
    elif cmd == "check" and args:
        opts = {"--allow-stale", "--rebuild", "--all-errors"}
        rest = [x for x in args if x not in opts]
        if len(rest) != 1:
            print(usage, file=sys.stderr); return 2
        out, err = safe(check, rest[0], "--allow-stale" in args, "--rebuild" in args, "--all-errors" in args)
    elif cmd == "compile" and args:
        rest = [x for x in args if x != "--deps-only"]
        if len(rest) != 1:
            print(usage, file=sys.stderr); return 2
        out, err = safe(compile_, rest[0], "--deps-only" in args)
    elif cmd == "impact" and len(args) == 1:
        out, err = safe(impact, args[0])
    elif cmd in ("start", "goto") and args:
        full = "--full" in args
        f, line, rest = split_file_line([x for x in args if x != "--full"])
        if rest:
            print(usage, file=sys.stderr); return 2
        out, err = safe(start if cmd == "start" else goto, f, line, full)
    elif cmd in ("run", "query") and len(args) == 2:
        f, line, _ = split_file_line(args[:1])
        out, err = safe(run if cmd == "run" else query, f, args[1], line or None)
    elif cmd == "back" and len(args) in (1, 2):
        out, err = safe(back, args[0], int(args[1]) if len(args) == 2 else 1)
    elif cmd == "stop" and args and args[0] in ("--all", "all") and set(args[1:]) <= {"--force"}:
        out, err = safe(stop, "--all", "--force" in args)
    elif cmd in ("goals", "stop", "info") and len(args) == 1:
        out, err = safe({"goals": goals, "stop": stop, "info": info}[cmd], args[0])
    elif cmd == "--version":
        out, err = "rocq-live " + VERSION, False
    else:
        print(usage, file=sys.stderr); return 2
    print(out)
    return int(err) if err else 0       # check: 2 = not checked


def entry():
    """Console-script entry point (pip/uv install)."""
    sys.exit(main(sys.argv[1:]))


if __name__ == "__main__":
    entry()
