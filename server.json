{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kylezh/rocq-live",
  "title": "rocq-live",
  "description": "Live Rocq (Coq) proof sessions for coding agents: goals, tactics, audits; no per-project setup",
  "version": "0.0.0+dev",
  "repository": {
    "url": "https://github.com/kylezh/rocq-live",
    "source": "github"
  },
  "websiteUrl": "https://github.com/kylezh/rocq-live",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "rocq-live",
      "version": "0.0.0+dev",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
